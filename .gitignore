node_modules/
/dist/
/web/dist/
.env
.env.local
.wrangler/
*.log
.DS_Store

# Supabase CLI scratch — the linked project ref and pooler settings it caches
# after `supabase link`. Machine-local, and it names whichever project that
# machine happens to be pointed at, so it must never be committed.
supabase/.temp/

# Member rosters: stripe-audit --csv and migrate-members --report write emails
# and names of real people, so they stay on the machine that made them.
*.csv
migrate-report*.json

# e2e runner output: reports, screenshots, traces, the app log and (until we
# decide to share it) the replay cache. See e2e/README.md.
e2e/.e2e/
