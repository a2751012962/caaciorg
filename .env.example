# Copy to .env and fill in. Used for local `wrangler pages dev` and the build.
# NEVER commit the real .env.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...           # public anon key (safe in browser)
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # SECRET — server only, never in browser

# --- Stripe (acct_1PfYMiJ3oYxWrRWD > Developers > API keys) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...    # `npm run stripe:connect -- --apply` fills this in

# --- Email notifications (Resend) ---
RESEND_API_KEY=re_...
NOTIFY_FROM="CAACI <no-reply@caaciorg.com>"
NOTIFY_TO=caaci.org@gmail.com
